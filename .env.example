# ShadowLens configuration. Copy to .env (git-ignored) and edit.
# Every name and default below is frozen in SOT.md section 5.4.
# Never put a real key in this file; only in your local .env.

# --- Server (binds to localhost only; do not change the host) ---
SHADOWLENS_HOST=127.0.0.1
SHADOWLENS_PORT=8787
SHADOWLENS_DESKTOP=true

# --- Storage ---
SHADOWLENS_DB_PATH=data/shadow.db
SHADOWLENS_SALT_PATH=data/salt

# --- Analysis ---
SHADOWLENS_MAX_BODY_BYTES=65536
SHADOWLENS_WORKSPACE_ROOTS=~/projects,~/source,/workspace
SHADOWLENS_INTERNAL_MARKERS=
SHADOWLENS_SANCTIONED=ollama

# --- Capture ---
# Background live scan every N seconds; 0 = off (one-shot scan still works).
SHADOWLENS_SCAN_INTERVAL_S=0
SHADOWLENS_RESOLVE=true
SHADOWLENS_LIVE_DIR=data/live
SHADOWLENS_TRANSCRIPTS_ENABLED=false
# Comma list of directories to restrict transcript scanning to (empty = registry defaults).
SHADOWLENS_TRANSCRIPT_DIRS=
SHADOWLENS_PROXY_ENABLED=false
SHADOWLENS_PROXY_PORT=11436
SHADOWLENS_PROXY_UPSTREAM=127.0.0.1:11434

# --- AI triage (optional; unset key = template mode) ---
SHADOWLENS_LLM_ENABLED=true
SHADOWLENS_LLM_TIMEOUT_S=15
SHADOWLENS_LLM_SEND_CONTEXT=true
SHADOWLENS_LLM_MAX_AUTO=12
FEATHERLESS_API_KEY=
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
FEATHERLESS_MODEL=
